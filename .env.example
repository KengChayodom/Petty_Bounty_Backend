SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_KEY=""
# Anon (publishable) key — same one the Flutter app uses. Only required if you
# enable the DEV-ONLY auth helpers below.
SUPABASE_ANON_KEY=""
HF_TOKEN=""

# Path to the Firebase Admin service-account JSON (FCM push). Leave unset to
# disable push; the rest of the API still runs.
FIREBASE_CREDENTIALS=""

# DEV-ONLY: mounts /dev/login and /dev/register (Supabase GoTrue proxies) so you
# can mint a bearer token from /docs. MUST stay false/unset in production —
# when false the routes do not exist at all (404).
ENABLE_DEV_AUTH=false
